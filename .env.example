# ---------------------------------------------------------------------------
# Muscle House Gym OS — environment variables
# Copy to .env.local for local development. Set the same keys in Vercel.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only secrets.
# ---------------------------------------------------------------------------

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=            # server only — never expose

# Public base URL (used in WhatsApp links and invoices)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=                          # openssl rand -hex 24

# Signs member-portal sessions
PORTAL_SESSION_SECRET=                # openssl rand -hex 32

# WhatsApp Business Platform (official Cloud API). Leave as "mock" until
# Meta has approved your number and templates — mock messages are clearly
# marked SIMULATED and are never reported as delivered.
WHATSAPP_PROVIDER=mock                # mock | meta_cloud
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=                  # verifies webhook signatures
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
